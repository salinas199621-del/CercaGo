{
  "name": "cercago-marketplace",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.3.0"
  },
  "workspaces": [
    "apps/api",
    "apps/mobile",
    "apps/admin",
    "apps/website"
  ],
  "devDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "scripts": {
    "start": "npm run start -w @cercago/api",
    "dev:api": "npm run dev -w @cercago/api",
    "dev:mobile": "npm run start -w @cercago/mobile",
    "dev:admin": "npm run dev -w @cercago/admin",
    "dev:website": "npm run dev -w @cercago/website",
    "build:api": "npm run build -w @cercago/api",
    "build:admin": "npm run build -w @cercago/admin",
    "build:website": "npm run build -w @cercago/website"
  }
}
